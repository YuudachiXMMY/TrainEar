# 复制为 .env 并按需填写。全部可选：不配置 SMTP 时，验证码会打印在运行服务的终端里（本地开发模式）。
# PORT=8321
# DATA_DIR=./data

# 配置以下 SMTP 项后，验证码将真实发送到邮箱：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0            # 1 = 465 隐式 TLS；0 = STARTTLS
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# SMTP_FROM=练耳训练器 <you@example.com>
# SMTP_IGNORE_TLS=0        # 1 = 明文直连不升级 TLS（仅限内网，如 IthacaServer 上 docker 网内的 stalwart:25）
# SMTP_TLS_INSECURE=0      # 1 = TLS 但不校验证书（仅限内网可信环境）

# IthacaServer 生产环境（Stalwart 内网直连）参考：
# SMTP_HOST=stalwart
# SMTP_PORT=25
# SMTP_SECURE=0
# SMTP_IGNORE_TLS=1
# SMTP_FROM=TrainEar <noreply@ithacateens.com>
